PLAYER_HOST=127.0.0.1
PLAYER_PORT=8080
PLAYER_PASSWORD=remplacer-par-un-long-mot-de-passe
# Adresse HTTPS ouverte dans le navigateur via votre reverse proxy.
# Sans chemin, avec le port public s’il est différent de 443.
# Vide pour un accès HTTP direct sur PLAYER_HOST:PLAYER_PORT.
# Plusieurs adresses : PLAYER_ORIGIN=http://192.168.1.50,https://player.example.fr
PLAYER_ORIGIN=
# Taille des blocs envoyés (10 à 100 ms).
PLAYER_AUDIO_BLOCK_MS=20
# Limite des files de capture (40 à 1000 ms, au moins 2 blocs), pas la latence totale.
PLAYER_AUDIO_MAX_BACKLOG_MS=200
